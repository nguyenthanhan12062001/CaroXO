<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_game_invite"
    style="@style/Widget.CaroXO.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_invite_avatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_avatar_ring"
                android:contentDescription="@string/cd_player_avatar"
                android:padding="5dp"
                android:src="@drawable/ic_avatar_ninja" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_invite_sender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_invite_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_invite_decline"
                style="@style/Widget.CaroXO.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/cd_invite_decline"
                android:text="@string/action_decline"
                android:textColor="?attr/colorOnErrorContainer"
                android:textSize="14sp"
                app:backgroundTint="?attr/colorErrorContainer"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="?attr/colorOnErrorContainer"
                app:strokeColor="?attr/colorError"
                app:strokeWidth="1.2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_invite_accept"
                style="@style/Widget.CaroXO.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:contentDescription="@string/cd_invite_accept"
                android:text="@string/action_accept"
                android:textColor="@color/caroxo_invite_accept_fg"
                android:textSize="14sp"
                app:backgroundTint="@color/caroxo_invite_accept_bg"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/caroxo_invite_accept_fg" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

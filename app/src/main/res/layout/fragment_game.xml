<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <!-- Minimalist Top Strip -->
    <LinearLayout
        android:id="@+id/top_strip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="600dp">

        <ImageButton
            android:id="@+id/btn_back_game"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_badge_surface"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/layout_room_code"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_room_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/cd_copy_room_code"
                android:src="@drawable/ic_copy"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_match_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:fontFamily="@font/jetbrains_mono"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Balanced Players HUD -->
    <LinearLayout
        android:id="@+id/players_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_strip"
        app:layout_constraintWidth_max="600dp">

        <!-- Player X Card -->
        <LinearLayout
            android:id="@+id/card_player_x"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_turn_active"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/iv_avatar_x"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_avatar_ring"
                android:contentDescription="@string/cd_player_avatar"
                android:padding="4dp"
                android:src="@drawable/ic_avatar_ninja" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_name_x"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/player_x_default"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_turn_x"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/turn_x_label"
                    android:textColor="@color/caroxo_x_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_score_x"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono"
                android:text="0"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center VS / Timer Pill -->
        <LinearLayout
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tv_vs_or_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:fontFamily="@font/jetbrains_mono"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="VS"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Player O Card -->
        <LinearLayout
            android:id="@+id/card_player_o"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_turn_inactive"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tv_score_o"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono"
                android:text="0"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_name_o"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/player_o_default"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_turn_o"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/turn_o_label"
                    android:textColor="@color/caroxo_o_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_avatar_o"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_avatar_ring"
                android:contentDescription="@string/cd_player_avatar"
                android:padding="4dp"
                android:src="@drawable/ic_avatar_robot" />
        </LinearLayout>
    </LinearLayout>

    <!-- Square 1:1 Board Container (Board/Piece Canvas untouched) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_board"
        style="@style/Widget.CaroXO.Card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="12dp"
        app:cardElevation="1dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/players_header"
        app:layout_constraintWidth_max="600dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.game.caroxo.an.ui.custom.CaroBoardView
                android:id="@+id/caro_board_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_board" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_zoom_reset"
                style="@style/Widget.CaroXO.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:minHeight="38dp"
                android:paddingHorizontal="12dp"
                android:text="@string/btn_zoom_reset"
                android:textSize="11sp"
                android:visibility="gone"
                app:cornerRadius="19dp"
                app:icon="@drawable/ic_zoom_reset"
                app:iconSize="16dp" />

            <TextView
                android:id="@+id/tv_ai_thinking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pill"
                android:elevation="2dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:text="@string/ai_thinking"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="600dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_undo"
            style="@style/Widget.CaroXO.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:text="@string/btn_undo"
            android:textSize="12sp"
            app:icon="@drawable/ic_undo"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hint"
            style="@style/Widget.CaroXO.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:text="@string/btn_hint"
            android:textSize="12sp"
            app:icon="@drawable/ic_hint"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.CaroXO.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:text="@string/btn_reset"
            android:textSize="12sp"
            app:icon="@drawable/ic_reset"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="18dp" />

        <FrameLayout
            android:id="@+id/layout_room_chat_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_room_chat"
                style="@style/Widget.CaroXO.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:text="@string/btn_room_chat"
                android:textSize="13sp"
                app:icon="@drawable/ic_chat"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp" />

            <TextView
                android:id="@+id/tv_room_chat_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_unread_dot"
                android:fontFamily="@font/jetbrains_mono"
                android:gravity="center"
                android:minWidth="20dp"
                android:paddingHorizontal="5dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_game_menu"
            style="@style/Widget.CaroXO.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="0.88"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:text="@string/btn_menu"
            android:textSize="12sp"
            app:icon="@drawable/ic_menu_more"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="18dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_discovery_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="600dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

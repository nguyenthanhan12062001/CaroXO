<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- Incoming Message (Other Player) -->
    <LinearLayout
        android:id="@+id/layout_incoming_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom|start"
        android:orientation="horizontal"
        android:paddingEnd="56dp">

        <ImageView
            android:id="@+id/iv_chat_avatar_other"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_avatar_ring"
            android:contentDescription="@string/cd_player_avatar"
            android:padding="4dp"
            android:src="@drawable/ic_avatar_ninja" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chat_bubble_other"
            android:orientation="vertical"
            android:paddingHorizontal="13dp"
            android:paddingVertical="9dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_chat_sender_other"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLength="24"
                    android:maxLines="1"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_chat_time_other"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_chat_text_other"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Outgoing Message (Current Player) -->
    <LinearLayout
        android:id="@+id/layout_outgoing_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="56dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_mine"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp">

            <TextView
                android:id="@+id/tv_chat_text_mine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_chat_time_mine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="3dp"
                android:alpha="0.82"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

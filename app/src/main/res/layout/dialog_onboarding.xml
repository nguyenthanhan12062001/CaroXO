<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_icon_badge_surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Action Bar inside Dialog -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_badge"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_nav_play"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="CaroXO Tour"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_skip"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/onboarding_skip"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </RelativeLayout>

    <!-- Pager Area -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_onboarding"
        android:layout_width="match_parent"
        android:layout_height="370dp" />

    <!-- Page Indicator Dots -->
    <LinearLayout
        android:id="@+id/layout_indicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/indicator_0"
            android:layout_width="22dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="?attr/colorPrimary" />

        <View
            android:id="@+id/indicator_1"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="?attr/colorOutline" />

        <View
            android:id="@+id/indicator_2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="?attr/colorOutline" />

        <View
            android:id="@+id/indicator_3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="?attr/colorOutline" />
    </LinearLayout>

    <!-- Action Button (Next / Start Discovery) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_onboarding_action"
        style="@style/Widget.CaroXO.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/onboarding_next"
        app:icon="@drawable/ic_chevron_right"
        app:iconGravity="textEnd" />
</LinearLayout>

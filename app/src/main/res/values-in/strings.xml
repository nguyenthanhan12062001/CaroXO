    <string name="discovery_home_online_desc">Masuk untuk membuat atau gabung ruang 6 digit berbatas waktu 30 detik. Setelah selesai, ketuk Lanjutkan untuk tanding ulang cepat atau Ke Beranda.</string>
    <string name="discovery_home_friends_title">Teman &amp; Undangan Instan</string>
    <string name="discovery_home_friends_desc">Ketuk ikon Teman di atas untuk melihat teman online (titik hijau), cari via ID Pemain, dan kirim/terima popup ajakan duel maupun tanding ulang.</string>
    <string name="discovery_friends_title">Teman Online &amp; Popup Duel</string>
    <string name="discovery_friends_desc">Titik hijau menandakan teman sedang online. Undang teman bermain — mereka akan menerima popup mencolok dengan tombol Terima (✓) dan Tolak (✕).</string>

    <string name="discovery_game_controls_title">Kontrol Papan Canvas</string>
    <string name="discovery_game_controls_desc">Sentuh kotak untuk meletakkan bidak • Geser 1 jari untuk geser • Cubit 2 jari untuk zoom (1x–3x) • Gunakan Saran, Urung &amp; Setelan Cepat.</string>

    <string name="discovery_lb_title">Papan Peringkat &amp; ID</string>
    <string name="discovery_lb_desc">Menang +10 poin, kalah -5 poin. Cek ID unik di bawah nama pemain, ketuk untuk melihat profil, dan masuk Top 1–3 untuk membuka gaya bidak VIP.</string>

    <string name="discovery_chat_title">Obrolan Lobi &amp; Ruang</string>
    <string name="discovery_chat_desc">Kirim pesan real-time di Obrolan Global atau obrolan ruang privat, ketuk avatar untuk melihat profil dan lencana Admin terverifikasi.</string>

    <string name="discovery_profile_title">Profil &amp; Riwayat Laga</string>
    <string name="discovery_profile_desc">Pilih Avatar dan Gaya Bidak favorit, pantau Lencana Puncak Anda, dan tinjau 10 pertandingan terakhir.</string>


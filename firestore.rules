rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPieceStyle(style) {
      return style is string && style in [
        'CLASSIC', 'NEON_CYBER', 'WOOD_CLASSIC', 'SYMBOL',
        'VIP_CRIMSON_EMBER', 'VIP_PLASMA_VORTEX', 'VIP_CELESTIAL_MONARCH'
      ];
    }

    function isValidPlayerProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 24 &&
             data.avatarId is string && data.avatarId.size() >= 1 && data.avatarId.size() <= 32 &&
             isValidPieceStyle(data.pieceStyle) &&
             data.wins is int && data.wins >= 0 && data.wins <= 1000000 &&
             data.losses is int && data.losses >= 0 && data.losses <= 1000000 &&
             data.draws is int && data.draws >= 0 && data.draws <= 1000000 &&
             data.points is int && data.points >= 0 && data.points <= 10000000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPeakRankFields(data) {
      return data.bestRank is int && data.bestRank >= 0 && data.bestRank <= 1000000 &&
             data.bestPoints is int && data.bestPoints >= 0 && data.bestPoints <= 10000000;
    }

    function isValidLeaderboardEntry(data) {
      return isValidPlayerProfile(data) &&
             data.publicEntry is bool &&
             data.publicEntry == true;
    }

    function isValidGameRoom(data) {
      return data.roomCode is string && data.roomCode.size() == 6 && data.roomCode.matches('^[0-9]{6}$') &&
             data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.guestUid is string && data.guestUid.size() <= 128 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 2 &&
             data.memberUids[0] is string &&
             data.status is string && data.status in ['WAITING', 'PLAYING', 'FINISHED'] &&
             data.boardSize is int && data.boardSize in [10, 15, 20] &&
             data.blockTwoEnds is bool &&
             data.hostNickname is string && data.hostNickname.size() >= 1 && data.hostNickname.size() <= 24 &&
             data.hostAvatarId is string && data.hostAvatarId.size() >= 1 && data.hostAvatarId.size() <= 32 &&
             isValidPieceStyle(data.hostStyle) &&
             data.guestNickname is string && data.guestNickname.size() <= 24 &&
             data.guestAvatarId is string && data.guestAvatarId.size() <= 32 &&
             isValidPieceStyle(data.guestStyle) &&
             data.currentTurn is string && data.currentTurn in ['X', 'O'] &&
             data.moves is list && data.moves.size() <= 400 &&
             (data.moves.size() == 0 || data.moves[0] is string) &&
             data.lastMoveRow is int && data.lastMoveRow >= -1 && data.lastMoveRow < data.boardSize &&
             data.lastMoveCol is int && data.lastMoveCol >= -1 && data.lastMoveCol < data.boardSize &&
             data.winnerUid is string && data.winnerUid.size() <= 128 &&
             data.turnStartedAt is timestamp && data.turnStartedAt <= request.time &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatMessageBase(data) {
      return data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderNickname is string && data.senderNickname.size() >= 1 && data.senderNickname.size() <= 24 &&
             data.senderAvatarId is string && data.senderAvatarId.size() >= 1 && data.senderAvatarId.size() <= 32 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidGlobalChatMessage(data) {
      return isValidChatMessageBase(data) &&
             data.publicChannel is bool &&
             data.publicChannel == true;
    }

    function isValidRoomChatMessage(data) {
      return isValidChatMessageBase(data) &&
             data.roomCode is string && data.roomCode.size() == 6 && data.roomCode.matches('^[0-9]{6}$') &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 2 &&
             data.memberUids[0] is string;
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'nickname', 'avatarId', 'pieceStyle',
                         'wins', 'losses', 'draws', 'points',
                         'bestRank', 'bestPoints', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'nickname', 'avatarId', 'pieceStyle',
                         'wins', 'losses', 'draws', 'points',
                         'bestRank', 'bestPoints', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidPlayerProfile(incoming()) &&
                       isValidPeakRankFields(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidPlayerProfile(incoming()) &&
                       (!('bestRank' in incoming()) && !('bestPoints' in incoming()) || isValidPeakRankFields(incoming())) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'nickname', 'avatarId', 'pieceStyle',
                         'wins', 'losses', 'draws', 'points',
                         'bestRank', 'bestPoints', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /match_history/{matchId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(matchId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().opponentNickname is string && incoming().opponentNickname.size() >= 1 && incoming().opponentNickname.size() <= 24 &&
                         incoming().result is string && incoming().result in ['WIN', 'LOSS', 'DRAW'] &&
                         incoming().mode is string && incoming().mode.size() >= 1 && incoming().mode.size() <= 32 &&
                         incoming().durationSeconds is int && incoming().durationSeconds >= 0 && incoming().durationSeconds <= 86400 &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().keys().hasAll(['userId', 'opponentNickname', 'result', 'mode', 'durationSeconds', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'opponentNickname', 'result', 'mode', 'durationSeconds', 'createdAt']);

        allow update, delete: if false;
      }
    }

    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && existing().publicEntry == true;
      allow list: if isSignedIn() && existing().publicEntry == true;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'nickname', 'avatarId', 'pieceStyle',
                         'wins', 'losses', 'draws', 'points', 'publicEntry', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'nickname', 'avatarId', 'pieceStyle',
                         'wins', 'losses', 'draws', 'points', 'publicEntry', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'nickname', 'avatarId', 'pieceStyle',
                         'wins', 'losses', 'draws', 'points', 'publicEntry', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() &&
                    isValidId(roomId) &&
                    (existing().status == 'WAITING' || request.auth.uid in existing().memberUids);

      allow list: if isSignedIn() &&
                     (request.auth.uid in existing().memberUids || existing().status == 'WAITING');

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       roomId.matches('^[0-9]{6}$') &&
                       incoming().roomCode == roomId &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().guestUid == '' &&
                       incoming().memberUids.size() == 1 &&
                       incoming().memberUids[0] == request.auth.uid &&
                       incoming().status == 'WAITING' &&
                       incoming().currentTurn == 'X' &&
                       incoming().moves.size() == 0 &&
                       incoming().lastMoveRow == -1 &&
                       incoming().lastMoveCol == -1 &&
                       incoming().winnerUid == '' &&
                       incoming().keys().hasAll([
                         'roomCode', 'hostUid', 'guestUid', 'memberUids', 'status',
                         'boardSize', 'blockTwoEnds',
                         'hostNickname', 'hostAvatarId', 'hostStyle',
                         'guestNickname', 'guestAvatarId', 'guestStyle',
                         'currentTurn', 'moves', 'lastMoveRow', 'lastMoveCol', 'winnerUid',
                         'turnStartedAt', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'roomCode', 'hostUid', 'guestUid', 'memberUids', 'status',
                         'boardSize', 'blockTwoEnds',
                         'hostNickname', 'hostAvatarId', 'hostStyle',
                         'guestNickname', 'guestAvatarId', 'guestStyle',
                         'currentTurn', 'moves', 'lastMoveRow', 'lastMoveCol', 'winnerUid',
                         'turnStartedAt', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidGameRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidGameRoom(incoming()) &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().boardSize == existing().boardSize &&
                       incoming().blockTwoEnds == existing().blockTwoEnds &&
                       incoming().createdAt == existing().createdAt &&
                       existing().status != 'FINISHED' &&
                       (
                         // Action 1: Guest joins a WAITING room
                         (
                           existing().status == 'WAITING' &&
                           existing().guestUid == '' &&
                           request.auth.uid != existing().hostUid &&
                           incoming().status == 'PLAYING' &&
                           incoming().guestUid == request.auth.uid &&
                           incoming().memberUids.size() == 2 &&
                           existing().hostUid in incoming().memberUids &&
                           request.auth.uid in incoming().memberUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'guestUid', 'memberUids', 'status',
                             'guestNickname', 'guestAvatarId', 'guestStyle',
                             'turnStartedAt', 'updatedAt'
                           ])
                         ) ||
                         // Action 2: Active turn player submits a move
                         (
                           existing().status == 'PLAYING' &&
                           request.auth.uid in existing().memberUids &&
                           (
                             (existing().currentTurn == 'X' && request.auth.uid == existing().hostUid) ||
                             (existing().currentTurn == 'O' && request.auth.uid == existing().guestUid)
                           ) &&
                           incoming().moves.size() == existing().moves.size() + 1 &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'moves', 'lastMoveRow', 'lastMoveCol',
                             'currentTurn', 'status', 'winnerUid',
                             'turnStartedAt', 'updatedAt'
                           ])
                         ) ||
                         // Action 3: Host cancels waiting room OR member ends active game (timeout/resign)
                         (
                           (
                             existing().status == 'WAITING' &&
                             request.auth.uid == existing().hostUid &&
                             incoming().status == 'FINISHED' &&
                             incoming().winnerUid == 'CANCELLED' &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'status', 'winnerUid', 'updatedAt'
                             ])
                           ) ||
                           (
                             existing().status == 'PLAYING' &&
                             request.auth.uid in existing().memberUids &&
                             incoming().status == 'FINISHED' &&
                             incoming().winnerUid in [existing().hostUid, existing().guestUid, 'DRAW'] &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'status', 'winnerUid', 'updatedAt'
                             ])
                           )
                         ) ||
                         // Action 4: Member syncs own profile style/avatar/nickname inside room
                         (
                           (
                             request.auth.uid == existing().hostUid &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'hostNickname', 'hostAvatarId', 'hostStyle', 'updatedAt'
                             ])
                           ) ||
                           (
                             request.auth.uid == existing().guestUid &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'guestNickname', 'guestAvatarId', 'guestStyle', 'updatedAt'
                             ])
                           )
                         )
                       );

      allow delete: if isSignedIn() &&
                       isValidId(roomId) &&
                       request.auth.uid == existing().hostUid &&
                       existing().status != 'PLAYING';

      match /messages/{messageId} {
        allow get: if isSignedIn() &&
                      isValidId(roomId) &&
                      isValidId(messageId) &&
                      request.auth.uid in existing().memberUids;

        allow list: if isSignedIn() &&
                       request.auth.uid in existing().memberUids;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         roomId.matches('^[0-9]{6}$') &&
                         incoming().senderUid == request.auth.uid &&
                         incoming().roomCode == roomId &&
                         incoming().keys().hasAll([
                           'senderUid', 'senderNickname', 'senderAvatarId',
                           'text', 'roomCode', 'memberUids', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'senderUid', 'senderNickname', 'senderAvatarId',
                           'text', 'roomCode', 'memberUids', 'createdAt'
                         ]) &&
                         isValidRoomChatMessage(incoming()) &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids &&
                         incoming().memberUids == get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;

        allow update, delete: if false;
      }
    }

    match /global_chat/{messageId} {
      allow get: if isSignedIn() &&
                    isValidId(messageId) &&
                    existing().publicChannel == true;

      allow list: if isSignedIn() &&
                     existing().publicChannel == true;

      allow create: if isSignedIn() &&
                       isValidId(messageId) &&
                       incoming().senderUid == request.auth.uid &&
                       incoming().publicChannel == true &&
                       incoming().keys().hasAll([
                         'senderUid', 'senderNickname', 'senderAvatarId',
                         'text', 'publicChannel', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'senderUid', 'senderNickname', 'senderAvatarId',
                         'text', 'publicChannel', 'createdAt'
                       ]) &&
                       isValidGlobalChatMessage(incoming());

      allow update, delete: if false;
    }
  }
}
